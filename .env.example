# ============================================================================
# Template. Copy to .env and fill in. NEVER commit .env - it is gitignored.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# FTMO — choose ONE platform path
# ---------------------------------------------------------------------------
# PLATFORM NOTE FOR LINUX USERS: the official `MetaTrader5` Python package is
# WINDOWS ONLY. On Linux you have three options:
#   1. cTrader Open API  <- recommended; protobuf/TCP, officially cross-platform
#   2. MT5 under Wine    <- works, commonly done, fiddly
#   3. A Windows VPS     <- what most prop traders actually do
# FTMO offers MT4, MT5, cTrader and DXtrade. Pick cTrader when you create the
# free trial account and this whole problem disappears.

# --- Path 1: cTrader Open API (recommended on Linux) ---
# Register an application at https://connect.spotware.com/ to get id/secret,
# then run the OAuth flow to obtain the access token.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
# demo | live  — the free trial is a demo account
CTRADER_ENV=demo

# --- Path 2: MetaTrader 5 ---
# Credentials come from the FTMO dashboard once the account is created.
FTMO_MT5_LOGIN=
FTMO_MT5_PASSWORD=
FTMO_MT5_SERVER=
# Absolute path to terminal64.exe; only needed if not auto-detected
FTMO_MT5_PATH=

# How THIS host reaches the MT5 terminal. Exactly one of:
#   (a) nothing set, and this host is Windows  -> native, MetaTrader5 imports directly
#   (b) MT5_AGENT_URL                          -> terminal lives on another machine
#   (c) MT5_WINE_PREFIX                        -> MT5 under Wine on this host
#
# (b) over a Tailscale tailnet is the clean option: authenticated, encrypted,
# NAT-traversing, no port forwarding. Use the tailnet hostname, not a LAN IP,
# so it keeps working when either machine moves networks.
#   MT5_AGENT_URL=http://windows-desktop.tailnet-name.ts.net:8765
MT5_AGENT_URL=
MT5_AGENT_TOKEN=
MT5_WINE_PREFIX=

# ---------------------------------------------------------------------------
# Account parameters — must match the trial/challenge you were issued
# ---------------------------------------------------------------------------
# Used by the risk guard to compute the limits as fractions of INITIAL balance.
FTMO_INITIAL_BALANCE=200000
FTMO_MAX_DAILY_LOSS=0.05
FTMO_MAX_TOTAL_LOSS=0.10
FTMO_TARGET_VOL=0.12
# Rebalance time, exchange-local, kept clear of the economic calendar
REBALANCE_TIME=16:30
REBALANCE_TZ=America/New_York

# ---------------------------------------------------------------------------
# Market data vendors (research only — not needed for the free trial)
# ---------------------------------------------------------------------------
DATABENTO_API_KEY=
NORGATE_DATA_PATH=
CSI_USERNAME=
CSI_PASSWORD=
